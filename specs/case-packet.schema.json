{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AxioWeave simulation gate review snapshot 0.1.0",
  "description": "Experimental pre-round subset. Validation does not authenticate a source or authorize real actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "source_node_id", "community_id", "case_id", "case_version", "exported_at", "mode", "data_classification", "execution_enabled", "question", "charter_ref", "rules_ref", "evidence", "authority_records", "inclusion_audit", "constraints", "gates", "review_status"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile": {"const": "simulation_gate_review"},
    "source_node_id": {"$ref": "#/$defs/id"},
    "community_id": {"$ref": "#/$defs/id"},
    "case_id": {"$ref": "#/$defs/id"},
    "case_version": {"type": "integer", "minimum": 1},
    "exported_at": {"$ref": "#/$defs/timestamp"},
    "mode": {"const": "simulation"},
    "data_classification": {"const": "synthetic"},
    "execution_enabled": {"const": false},
    "question": {"$ref": "#/$defs/text"},
    "charter_ref": {"$ref": "#/$defs/evidenceRef"},
    "rules_ref": {"$ref": "#/$defs/evidenceRef"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "authority_records": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
    "inclusion_audit": {"$ref": "#/$defs/inclusion"},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "gates": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/gate"}},
    "review_status": {"enum": ["in_review", "blocked", "ready_for_round"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "revision"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "revision", "source_kind", "summary"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1},
        "source_kind": {"const": "synthetic"},
        "summary": {"$ref": "#/$defs/text"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "actor_id", "scope", "powers", "status", "valid_from", "valid_until", "basis_ref"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/id"},
        "actor_id": {"$ref": "#/$defs/id"},
        "scope": {"const": "freeze_round"},
        "powers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["assess_participation", "assess_constraints", "assess_mandate"]}},
        "status": {"enum": ["active", "withdrawn", "unknown"]},
        "valid_from": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"},
        "basis_ref": {"$ref": "#/$defs/evidenceRef"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["invited", "responded", "participating"],
      "properties": {
        "invited": {"type": ["integer", "null"], "minimum": 0},
        "responded": {"type": "integer", "minimum": 0},
        "participating": {"type": "integer", "minimum": 0}
      }
    },
    "stratum": {
      "type": "object", "additionalProperties": false,
      "required": ["group_id", "description", "counts"],
      "properties": {
        "group_id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/text"},
        "counts": {"$ref": "#/$defs/counts"}
      }
    },
    "inclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["population_description", "frame_description", "eligible_population", "window_start", "window_end", "counts", "strata", "strata_may_overlap", "support_measures", "limitations", "assessment_ref"],
      "properties": {
        "population_description": {"$ref": "#/$defs/text"},
        "frame_description": {"$ref": "#/$defs/text"},
        "eligible_population": {"type": ["integer", "null"], "minimum": 0},
        "window_start": {"$ref": "#/$defs/timestamp"},
        "window_end": {"$ref": "#/$defs/timestamp"},
        "counts": {"$ref": "#/$defs/counts"},
        "strata": {"type": "array", "items": {"$ref": "#/$defs/stratum"}},
        "strata_may_overlap": {"type": "boolean"},
        "support_measures": {"$ref": "#/$defs/texts"},
        "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "assessment_ref": {"$ref": "#/$defs/evidenceRef"}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "kind", "status", "description", "source_ref", "disposition_ref"],
      "properties": {
        "constraint_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["applicable_law", "adopted_charter", "participant_claim"]},
        "status": {"enum": ["asserted", "contested", "adopted", "inapplicable"]},
        "description": {"$ref": "#/$defs/text"},
        "source_ref": {"$ref": "#/$defs/evidenceRef"},
        "disposition_ref": {"anyOf": [{"$ref": "#/$defs/evidenceRef"}, {"type": "null"}]}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "kind", "action", "status", "case_revision", "reviewer_id", "authority_ref", "evidence_refs", "reason", "assessed_at", "valid_until"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["participation", "constraints", "mandate"]},
        "action": {"const": "freeze_round"},
        "status": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
        "case_revision": {"type": "integer", "minimum": 1},
        "reviewer_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "authority_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
        "reason": {"$ref": "#/$defs/text"},
        "assessed_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "valid_until": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    }
  }
}
